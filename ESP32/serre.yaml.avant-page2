# =============================================================================
#  Serre connectée - ESP32 NodeMCU WROOM-32 (CH340)
#  BME280 (température / humidité) + OLED 1,3" SH1106 + ventilateur Noctua 12 V
#
#  La régulation tourne entièrement sur l'ESP32 : elle continue de fonctionner
#  sans Home Assistant et même sans Wi-Fi. Home Assistant sert au suivi, aux
#  alertes et au réglage des seuils à distance.
# =============================================================================

substitutions:
  name: serre
  friendly_name: Serre
  # Au-dessus du seuil, le ventilateur monte progressivement de la vitesse de
  # base jusqu'à 100 % sur cette plage (en °C et en points d'humidité).
  rampe_temp: "3.0"
  rampe_hum: "10.0"
  # Vitesse de secours si le capteur ne répond plus (%).
  vitesse_secours: "50.0"
  # Les plages de température et d'humidité sont dans plages.yaml.

esphome:
  name: ${name}
  friendly_name: ${friendly_name}
  on_boot:
    priority: -100
    then:
      - script.execute: regulation

esp32:
  board: esp32dev

# --- Ventilateur : choisir UNE des deux lignes selon le modèle ---------------
#  4 fils (NF-R8 redux-1800 PWM) : vitesse réglée par le fil PWM bleu
#  3 fils (NF-R8 redux-1800)     : vitesse réglée en hachant l'alimentation
packages:
  plages: !include plages.yaml     # plages souhaitées et critiques
  # ventilateur: !include materiel/ventilateur_4fils.yaml
  ventilateur: !include materiel/ventilateur_3fils.yaml

logger:

api:
  encryption:
    key: !secret api_key
  # Par défaut l'ESP32 redémarre au bout de 15 min sans Home Assistant.
  # On le désactive : la serre doit tourner seule.
  reboot_timeout: 0s

ota:
  - platform: esphome
    password: !secret ota_password

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  reboot_timeout: 0s
  ap:
    ssid: "Serre secours"
    password: !secret ap_password

captive_portal:

# Heure via Internet (NTP), sans passer par Home Assistant. Sans heure valide,
# le renouvellement d'air tourne jour et nuit (mode sûr).
time:
  - platform: sntp
    id: horloge
    timezone: Europe/Paris

i2c:
  # Bus du capteur BME280
  - id: bus_capteur
    sda: GPIO21
    scl: GPIO22
    scan: true
  # Bus de l'écran OLED (éviter GPIO12 : broche de démarrage)
  - id: bus_ecran
    sda: GPIO32
    scl: GPIO33
    scan: true
    frequency: 400kHz        # rafraîchissement rapide pour l'animation

# -----------------------------------------------------------------------------
#  Capteurs
# -----------------------------------------------------------------------------
sensor:
  - platform: bme280_i2c
    i2c_id: bus_capteur
    address: 0x76          # 0x77 si le module a la broche SDO reliée au 3,3 V
    update_interval: 15s
    temperature:
      name: Température
      id: temperature
    humidity:
      name: Humidité
      id: humidite
    pressure:
      name: Pression

  # --- Statistiques sur 24 h glissantes ---------------------------------
  # Une moyenne toutes les 15 min, gardée 96 fois (= 24 h).
  # Elles repartent de zéro à chaque redémarrage de l'ESP32.
  - platform: copy
    source_id: temperature
    name: Température moyenne 24h
    filters:
      - throttle_average: 15min
      - sliding_window_moving_average:
          window_size: 96
          send_every: 1
  - platform: copy
    source_id: temperature
    name: Température min 24h
    filters:
      - throttle_average: 15min
      - min:
          window_size: 96
          send_every: 1
  - platform: copy
    source_id: temperature
    name: Température max 24h
    filters:
      - throttle_average: 15min
      - max:
          window_size: 96
          send_every: 1
  - platform: copy
    source_id: humidite
    name: Humidité moyenne 24h
    filters:
      - throttle_average: 15min
      - sliding_window_moving_average:
          window_size: 96
          send_every: 1
  - platform: copy
    source_id: humidite
    name: Humidité min 24h
    filters:
      - throttle_average: 15min
      - min:
          window_size: 96
          send_every: 1
  - platform: copy
    source_id: humidite
    name: Humidité max 24h
    filters:
      - throttle_average: 15min
      - max:
          window_size: 96
          send_every: 1

  - platform: template
    name: Vitesse ventilateur
    id: vitesse_publiee
    unit_of_measurement: "%"
    icon: mdi:fan
    accuracy_decimals: 0
    update_interval: 15s
    lambda: return id(vitesse_actuelle);

# -----------------------------------------------------------------------------
#  Réglages modifiables depuis Home Assistant
#  Les valeurs par défaut s'appliquent hors ligne, et chaque modification est
#  mémorisée dans l'ESP32 (restore_value).
# -----------------------------------------------------------------------------
number:
  - platform: template
    name: Vitesse de base
    id: vitesse_base
    icon: mdi:fan-speed-1
    unit_of_measurement: "%"
    min_value: 0
    max_value: 100
    step: 5
    initial_value: 25
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Renouvellement intervalle
    id: renouv_intervalle
    icon: mdi:timer-refresh
    unit_of_measurement: h
    min_value: 1
    max_value: 12
    step: 0.5
    initial_value: 3
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Renouvellement durée
    id: renouv_duree
    icon: mdi:timer-outline
    unit_of_measurement: min
    min_value: 0
    max_value: 60
    step: 1
    initial_value: 15
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Début de journée
    id: jour_debut
    icon: mdi:weather-sunset-up
    unit_of_measurement: h
    min_value: 0
    max_value: 23
    step: 1
    initial_value: 8
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Fin de journée
    id: jour_fin
    icon: mdi:weather-sunset-down
    unit_of_measurement: h
    min_value: 0
    max_value: 23
    step: 1
    initial_value: 20
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Vitesse manuelle
    id: vitesse_manuelle
    icon: mdi:fan
    unit_of_measurement: "%"
    min_value: 0
    max_value: 100
    step: 5
    initial_value: 50
    optimistic: true
    restore_value: true
    on_value:
      - script.execute: regulation

switch:
  - platform: template
    name: Mode manuel
    id: mode_manuel
    icon: mdi:hand-back-right
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    on_turn_on:
      - script.execute: regulation
    on_turn_off:
      - script.execute: regulation

button:
  - platform: template
    name: Renouveler l'air maintenant
    icon: mdi:weather-windy
    on_press:
      - lambda: |-
          id(renouv_restant) = (int) id(renouv_duree).state;
          id(minutes_depuis_renouv) = 0;
      - script.execute: regulation

  - platform: restart
    name: Redémarrer

# -----------------------------------------------------------------------------
#  États pour les alertes Home Assistant
# -----------------------------------------------------------------------------
binary_sensor:
  - platform: status
    name: Connectée

  - platform: template
    name: Renouvellement en cours
    icon: mdi:weather-windy
    lambda: return id(renouv_restant) > 0;

  - platform: template
    name: Capteur en défaut
    device_class: problem
    lambda: return isnan(id(temperature).state) || isnan(id(humidite).state);

  - platform: template
    name: Température critique
    id: temp_critique
    device_class: heat
    lambda: |-
      const float t = id(temperature).state;
      return t < ${temp_critique_min} || t > ${temp_critique_max};
    filters:
      - delayed_on: 2min        # évite les fausses alertes sur un pic isolé
      - delayed_off: 5min

  - platform: template
    name: Humidité critique
    id: hum_critique
    device_class: moisture
    lambda: |-
      const float h = id(humidite).state;
      return h < ${hum_critique_min} || h > ${hum_critique_max};
    filters:
      - delayed_on: 2min
      - delayed_off: 5min

  # Entité unique à surveiller pour les notifications sur le téléphone.
  - platform: template
    name: Alerte critique
    id: alerte_critique
    device_class: problem
    lambda: return id(temp_critique).state || id(hum_critique).state;

text_sensor:
  - platform: template
    name: État température
    icon: mdi:thermometer
    update_interval: 15s
    lambda: |-
      const float t = id(temperature).state;
      if (isnan(t)) return {"Capteur absent"};
      if (t < ${temp_min}) return {"Trop froid"};
      if (t > ${temp_max}) return {"Trop chaud"};
      return {"OK"};

  - platform: template
    name: État humidité
    icon: mdi:water-percent
    update_interval: 15s
    lambda: |-
      const float h = id(humidite).state;
      if (isnan(h)) return {"Capteur absent"};
      if (h < ${hum_min}) return {"Trop sec"};
      if (h > ${hum_max}) return {"Trop humide"};
      return {"OK"};

# -----------------------------------------------------------------------------
#  Régulation
# -----------------------------------------------------------------------------
globals:
  - id: vitesse_actuelle        # vitesse appliquée, en %
    type: float
    initial_value: "0"
  - id: minutes_depuis_renouv
    type: int
    initial_value: "0"
  - id: renouv_restant          # minutes de renouvellement restantes
    type: int
    initial_value: "0"

interval:
  # Toutes les minutes : planification du renouvellement d'air.
  - interval: 1min
    then:
      - lambda: |-
          if (id(renouv_restant) > 0) {
            id(renouv_restant)--;
            return;
          }
          id(minutes_depuis_renouv)++;

          bool jour = true;  // sans heure valide, on renouvelle à toute heure
          auto maintenant = id(horloge).now();
          if (maintenant.is_valid()) {
            int h = maintenant.hour;
            int debut = (int) id(jour_debut).state;
            int fin = (int) id(jour_fin).state;
            jour = (debut <= fin) ? (h >= debut && h < fin) : (h >= debut || h < fin);
          }

          if (jour && id(renouv_duree).state > 0 &&
              id(minutes_depuis_renouv) >= id(renouv_intervalle).state * 60) {
            id(renouv_restant) = (int) id(renouv_duree).state;
            id(minutes_depuis_renouv) = 0;
          }

  # Toutes les 10 s : calcul et application de la vitesse.
  - interval: 10s
    then:
      - script.execute: regulation

script:
  - id: regulation
    mode: single
    then:
      - lambda: |-
          const float t = id(temperature).state;
          const float h = id(humidite).state;
          const float base = id(vitesse_base).state;
          float v;

          if (id(mode_manuel).state) {
            v = id(vitesse_manuelle).state;
            // Sécurité : même en manuel, plein régime en cas de forte chaleur.
            if (!isnan(t) && t > ${temp_max} + ${rampe_temp}) v = 100.0f;
          } else if (isnan(t) || isnan(h)) {
            // Capteur muet : on ventile franchement par précaution.
            v = std::max(base, ${vitesse_secours}f);
          } else {
            v = base;
            // Montée progressive au-dessus des seuils.
            const float dt = (t - ${temp_max}) / ${rampe_temp};
            const float dh = (h - ${hum_max}) / ${rampe_hum};
            const float exces = std::max(dt, dh);
            if (exces > 0) v = base + (100.0f - base) * std::min(1.0f, exces);
            if (id(renouv_restant) > 0) v = 100.0f;
          }

          v = std::max(0.0f, std::min(100.0f, v));
          id(vitesse_actuelle) = v;
          id(fan_pwm).set_level(v / 100.0f);

# -----------------------------------------------------------------------------
#  Écran OLED 1,3" (contrôleur SH1106, 128x64)
#   Colonne gauche : température, humidité, ventilateur (icône animée + %)
#   Colonne droite : état de la température, de l'humidité, mode du ventilateur
#   Valeur critique dépassée : la colonne droite clignote avec un panneau ⚠
# -----------------------------------------------------------------------------
font:
  - file: "polices\\Roboto-Medium.ttf"   # police locale, pas besoin d'Internet
    id: police_grande
    size: 18
  - file: "polices\\Roboto-Medium.ttf"
    id: police_moyenne
    size: 13
  - file: "polices\\Roboto-Medium.ttf"
    id: police_petite
    size: 11

display:
  - platform: ssd1306_i2c
    i2c_id: bus_ecran
    model: "SH1106 128x64"   # si l'image est décalée ou brouillée : "SSD1306 128x64"
    address: 0x3C
    update_interval: 200ms   # 5 images par seconde pour animer le ventilateur
    lambda: |-
      const float t = id(temperature).state;
      const float h = id(humidite).state;
      const float v = id(vitesse_actuelle);

      // ---------------- Colonne gauche ----------------
      if (isnan(t) || isnan(h)) {
        it.print(0, 0, id(police_moyenne), "Capteur");
        it.print(0, 18, id(police_moyenne), "absent");
      } else {
        it.printf(0, 0, id(police_grande), "%.1f°C", t);
        it.printf(0, 21, id(police_grande), "%.0f %%", h);
      }

      // Ventilateur : 3 pales qui tournent d'autant plus vite que la vitesse est haute.
      static float angle = 0;
      angle += v * 0.6f;                 // 60° par image à 100 %, rien à 0 %
      if (angle >= 360.0f) angle -= 360.0f;
      const int cx = 9, cy = 54, r = 8;
      for (int i = 0; i < 3; i++) {
        const float a = (angle + i * 120.0f) * 3.14159f / 180.0f;
        it.filled_triangle(cx, cy,
                           cx + (int) (r * cosf(a - 0.45f)), cy + (int) (r * sinf(a - 0.45f)),
                           cx + (int) (r * cosf(a + 0.45f)), cy + (int) (r * sinf(a + 0.45f)));
      }
      it.circle(cx, cy, r + 1);
      it.printf(22, 47, id(police_moyenne), "%.0f %%", v);

      // Séparation des deux colonnes
      it.line(70, 0, 70, 63);

      // ---------------- Colonne droite ----------------
      const bool critique = id(alerte_critique).state;
      if (critique && (millis() / 700) % 2 == 0) {
        // Panneau « attention » : grand triangle avec un point d'exclamation.
        it.filled_triangle(99, 2, 73, 60, 125, 60);
        it.print(99, 40, id(police_grande), COLOR_OFF, TextAlign::CENTER, "!");
        return;
      }

      // Affiche OK, ou une étiquette en négatif avec une flèche vers le haut ou le bas.
      auto etat = [&](int y, int niveau, const char *bas, const char *haut) {
        if (niveau == 0) {
          it.print(99, y, id(police_moyenne), TextAlign::TOP_CENTER, "OK");
          return;
        }
        it.filled_rectangle(73, y - 1, 55, 17);
        if (niveau > 0) it.filled_triangle(79, y + 2, 75, y + 11, 83, y + 11, COLOR_OFF);
        else            it.filled_triangle(75, y + 3, 83, y + 3, 79, y + 12, COLOR_OFF);
        it.print(106, y + 1, id(police_petite), COLOR_OFF, TextAlign::TOP_CENTER,
                 niveau > 0 ? haut : bas);
      };

      if (!isnan(t)) etat(2, t < ${temp_min} ? -1 : (t > ${temp_max} ? 1 : 0), "FROID", "CHAUD");
      if (!isnan(h)) etat(23, h < ${hum_min} ? -1 : (h > ${hum_max} ? 1 : 0), "SEC", "HUMIDE");

      const char *mode = "AUTO";
      if (id(mode_manuel).state) mode = "MANUEL";
      else if (id(renouv_restant) > 0) mode = "RENOUV.";
      it.print(99, 48, id(police_petite), TextAlign::TOP_CENTER, mode);
