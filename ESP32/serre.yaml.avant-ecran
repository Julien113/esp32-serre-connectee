# =============================================================================
#  Serre connectée - ESP32 NodeMCU WROOM-32 (CH340)
#  BME280 (température / humidité) + OLED 1,3" SH1106 + ventilateur Noctua 12 V
#
#  La régulation tourne entièrement sur l'ESP32 : elle continue de fonctionner
#  sans Home Assistant et même sans Wi-Fi. Home Assistant sert au suivi, aux
#  alertes et au réglage des seuils à distance.
# =============================================================================

substitutions:
  name: serre
  friendly_name: Serre
  # Au-dessus du seuil, le ventilateur monte progressivement de la vitesse de
  # base jusqu'à 100 % sur cette plage (en °C et en points d'humidité).
  rampe_temp: "3.0"
  rampe_hum: "10.0"
  # Vitesse de secours si le capteur ne répond plus (%).
  vitesse_secours: "50.0"

esphome:
  name: ${name}
  friendly_name: ${friendly_name}
  on_boot:
    priority: -100
    then:
      - script.execute: regulation

esp32:
  board: esp32dev

# --- Ventilateur : choisir UNE des deux lignes selon le modèle ---------------
#  4 fils (NF-R8 redux-1800 PWM) : vitesse réglée par le fil PWM bleu
#  3 fils (NF-R8 redux-1800)     : vitesse réglée en hachant l'alimentation
packages:
  # ventilateur: !include materiel/ventilateur_4fils.yaml
  ventilateur: !include materiel/ventilateur_3fils.yaml

logger:

api:
  encryption:
    key: !secret api_key
  # Par défaut l'ESP32 redémarre au bout de 15 min sans Home Assistant.
  # On le désactive : la serre doit tourner seule.
  reboot_timeout: 0s

ota:
  - platform: esphome
    password: !secret ota_password

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  reboot_timeout: 0s
  ap:
    ssid: "Serre secours"
    password: !secret ap_password

captive_portal:

# Heure via Internet (NTP), sans passer par Home Assistant. Sans heure valide,
# le renouvellement d'air tourne jour et nuit (mode sûr).
time:
  - platform: sntp
    id: horloge
    timezone: Europe/Paris

i2c:
  # Bus du capteur BME280
  - id: bus_capteur
    sda: GPIO21
    scl: GPIO22
    scan: true
  # Bus de l'écran OLED (éviter GPIO12 : broche de démarrage)
  - id: bus_ecran
    sda: GPIO32
    scl: GPIO33
    scan: true

# -----------------------------------------------------------------------------
#  Capteurs
# -----------------------------------------------------------------------------
sensor:
  - platform: bme280_i2c
    i2c_id: bus_capteur
    address: 0x76          # 0x77 si le module a la broche SDO reliée au 3,3 V
    update_interval: 15s
    temperature:
      name: Température
      id: temperature
    humidity:
      name: Humidité
      id: humidite
    pressure:
      name: Pression

  - platform: template
    name: Vitesse ventilateur
    id: vitesse_publiee
    unit_of_measurement: "%"
    icon: mdi:fan
    accuracy_decimals: 0
    update_interval: 15s
    lambda: return id(vitesse_actuelle);

# -----------------------------------------------------------------------------
#  Réglages modifiables depuis Home Assistant
#  Les valeurs par défaut s'appliquent hors ligne, et chaque modification est
#  mémorisée dans l'ESP32 (restore_value).
# -----------------------------------------------------------------------------
number:
  - platform: template
    name: Vitesse de base
    id: vitesse_base
    icon: mdi:fan-speed-1
    unit_of_measurement: "%"
    min_value: 0
    max_value: 100
    step: 5
    initial_value: 25
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Seuil température ventilation
    id: temp_max
    icon: mdi:thermometer-high
    unit_of_measurement: "°C"
    min_value: 18
    max_value: 40
    step: 0.5
    initial_value: 28
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Seuil humidité ventilation
    id: hum_max
    icon: mdi:water-percent-alert
    unit_of_measurement: "%"
    min_value: 50
    max_value: 100
    step: 1
    initial_value: 85
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Alerte température basse
    id: temp_min
    icon: mdi:thermometer-low
    unit_of_measurement: "°C"
    min_value: 5
    max_value: 30
    step: 0.5
    initial_value: 22
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Alerte humidité basse
    id: hum_min
    icon: mdi:water-percent
    unit_of_measurement: "%"
    min_value: 20
    max_value: 90
    step: 1
    initial_value: 60
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Renouvellement intervalle
    id: renouv_intervalle
    icon: mdi:timer-refresh
    unit_of_measurement: h
    min_value: 1
    max_value: 12
    step: 0.5
    initial_value: 3
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Renouvellement durée
    id: renouv_duree
    icon: mdi:timer-outline
    unit_of_measurement: min
    min_value: 0
    max_value: 60
    step: 1
    initial_value: 15
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Début de journée
    id: jour_debut
    icon: mdi:weather-sunset-up
    unit_of_measurement: h
    min_value: 0
    max_value: 23
    step: 1
    initial_value: 8
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Fin de journée
    id: jour_fin
    icon: mdi:weather-sunset-down
    unit_of_measurement: h
    min_value: 0
    max_value: 23
    step: 1
    initial_value: 20
    optimistic: true
    restore_value: true
    entity_category: config

  - platform: template
    name: Vitesse manuelle
    id: vitesse_manuelle
    icon: mdi:fan
    unit_of_measurement: "%"
    min_value: 0
    max_value: 100
    step: 5
    initial_value: 50
    optimistic: true
    restore_value: true
    on_value:
      - script.execute: regulation

switch:
  - platform: template
    name: Mode manuel
    id: mode_manuel
    icon: mdi:hand-back-right
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF
    on_turn_on:
      - script.execute: regulation
    on_turn_off:
      - script.execute: regulation

button:
  - platform: template
    name: Renouveler l'air maintenant
    icon: mdi:weather-windy
    on_press:
      - lambda: |-
          id(renouv_restant) = (int) id(renouv_duree).state;
          id(minutes_depuis_renouv) = 0;
      - script.execute: regulation

  - platform: restart
    name: Redémarrer

# -----------------------------------------------------------------------------
#  États pour les alertes Home Assistant
# -----------------------------------------------------------------------------
binary_sensor:
  - platform: status
    name: Connectée

  - platform: template
    name: Renouvellement en cours
    icon: mdi:weather-windy
    lambda: return id(renouv_restant) > 0;

  - platform: template
    name: Capteur en défaut
    device_class: problem
    lambda: return isnan(id(temperature).state) || isnan(id(humidite).state);

  - platform: template
    name: Trop chaud
    device_class: heat
    # Ventilateur déjà à fond et toujours au-dessus : la ventilation ne suffit plus.
    lambda: return id(temperature).state > id(temp_max).state + ${rampe_temp};
    filters:
      - delayed_on: 10min

  - platform: template
    name: Trop froid
    device_class: cold
    lambda: return id(temperature).state < id(temp_min).state;
    filters:
      - delayed_on: 10min

  - platform: template
    name: Trop sec
    device_class: problem
    lambda: return id(humidite).state < id(hum_min).state;
    filters:
      - delayed_on: 30min

# -----------------------------------------------------------------------------
#  Régulation
# -----------------------------------------------------------------------------
globals:
  - id: vitesse_actuelle        # vitesse appliquée, en %
    type: float
    initial_value: "0"
  - id: minutes_depuis_renouv
    type: int
    initial_value: "0"
  - id: renouv_restant          # minutes de renouvellement restantes
    type: int
    initial_value: "0"

interval:
  # Toutes les minutes : planification du renouvellement d'air.
  - interval: 1min
    then:
      - lambda: |-
          if (id(renouv_restant) > 0) {
            id(renouv_restant)--;
            return;
          }
          id(minutes_depuis_renouv)++;

          bool jour = true;  // sans heure valide, on renouvelle à toute heure
          auto maintenant = id(horloge).now();
          if (maintenant.is_valid()) {
            int h = maintenant.hour;
            int debut = (int) id(jour_debut).state;
            int fin = (int) id(jour_fin).state;
            jour = (debut <= fin) ? (h >= debut && h < fin) : (h >= debut || h < fin);
          }

          if (jour && id(renouv_duree).state > 0 &&
              id(minutes_depuis_renouv) >= id(renouv_intervalle).state * 60) {
            id(renouv_restant) = (int) id(renouv_duree).state;
            id(minutes_depuis_renouv) = 0;
          }

  # Toutes les 10 s : calcul et application de la vitesse.
  - interval: 10s
    then:
      - script.execute: regulation

script:
  - id: regulation
    mode: single
    then:
      - lambda: |-
          const float t = id(temperature).state;
          const float h = id(humidite).state;
          const float base = id(vitesse_base).state;
          float v;

          if (id(mode_manuel).state) {
            v = id(vitesse_manuelle).state;
            // Sécurité : même en manuel, plein régime en cas de forte chaleur.
            if (!isnan(t) && t > id(temp_max).state + ${rampe_temp}) v = 100.0f;
          } else if (isnan(t) || isnan(h)) {
            // Capteur muet : on ventile franchement par précaution.
            v = std::max(base, ${vitesse_secours}f);
          } else {
            v = base;
            // Montée progressive au-dessus des seuils.
            const float dt = (t - id(temp_max).state) / ${rampe_temp};
            const float dh = (h - id(hum_max).state) / ${rampe_hum};
            const float exces = std::max(dt, dh);
            if (exces > 0) v = base + (100.0f - base) * std::min(1.0f, exces);
            if (id(renouv_restant) > 0) v = 100.0f;
          }

          v = std::max(0.0f, std::min(100.0f, v));
          id(vitesse_actuelle) = v;
          id(fan_pwm).set_level(v / 100.0f);

# -----------------------------------------------------------------------------
#  Écran OLED 1,3" (contrôleur SH1106, 128x64)
# -----------------------------------------------------------------------------
font:
  - file: "polices\\Roboto-Medium.ttf"   # police locale, pas besoin d'Internet
    id: police_grande
    size: 22
  - file: "polices\\Roboto-Medium.ttf"
    id: police_petite
    size: 13

display:
  - platform: ssd1306_i2c
    i2c_id: bus_ecran
    model: "SH1106 128x64"   # si l'image est décalée ou brouillée : "SSD1306 128x64"
    address: 0x3C
    update_interval: 2s
    lambda: |-
      const float t = id(temperature).state;
      const float h = id(humidite).state;

      if (isnan(t) || isnan(h)) {
        it.print(0, 0, id(police_petite), "Capteur absent");
      } else {
        it.printf(0, 0, id(police_grande), "%.1f °C", t);
        it.printf(0, 24, id(police_grande), "%.0f %%", h);
      }

      const char *mode = "";
      if (id(mode_manuel).state) mode = " manu";
      else if (id(renouv_restant) > 0) mode = " renouv";
      it.printf(0, 50, id(police_petite), "Vent. %.0f %%%s", id(vitesse_actuelle), mode);
